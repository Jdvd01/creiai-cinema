{
  "name": "cinema",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter=server --filter=web dev",
    "build": "pnpm --filter=shared build && pnpm --filter=server --filter=web build",
    "build:ext": "pnpm --filter=extension build",
    "typecheck": "pnpm -r typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
