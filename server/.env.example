PORT=3001
CORS_ORIGIN=http://localhost:3000

# ── LiveKit Cloud ─────────────────────────────────────────────────────────────
# Obtén las credenciales en https://cloud.livekit.io → tu proyecto → Settings → Keys
LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── LiveKit local (opcional, solo dev sin internet) ───────────────────────────
# docker compose up -d
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=devsecret00000000000000000000000

# ── Production (Railway) ──────────────────────────────────────────────────────
# PORT is injected automatically by Railway — do not set it manually
# CORS_ORIGIN=https://web-production-xxxx.up.railway.app
