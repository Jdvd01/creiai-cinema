FROM node:20-alpine AS builder
RUN npm install -g pnpm
WORKDIR /app

# Install deps (cached layer — only package.json files)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json ./packages/shared/
COPY server/package.json ./server/
COPY apps/web/package.json ./apps/web/
COPY apps/extension/package.json ./apps/extension/
RUN pnpm install --frozen-lockfile

# Build-time env vars (must be ARG so Railway passes them at docker build)
ARG NEXT_PUBLIC_SERVER_URL
ENV NEXT_PUBLIC_SERVER_URL=$NEXT_PUBLIC_SERVER_URL

# Build
COPY packages/shared ./packages/shared
COPY apps/web ./apps/web
RUN pnpm --filter=shared build && pnpm --filter=web build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
# Required for Next.js standalone to bind on all interfaces
ENV HOSTNAME=0.0.0.0

# standalone output includes its own minimal node_modules
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public

EXPOSE 3000
CMD ["node", "apps/web/server.js"]
